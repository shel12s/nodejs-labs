<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  {{> header}}

  <div class="layout">

    <aside class="sidebar">
      <h3>Міста</h3>
      <ul>
        {{#each cities}}
        <li>
          <a href="/weather/{{slug}}" class="{{#if (eq slug ../selectedCity.slug)}}active{{/if}}">
            {{name}}
          </a>
        </li>
        {{/each}}
      </ul>
    </aside>

    <main class="content">
      <h2>Погода у місті {{selectedCity.name}}</h2>

      <table class="weather-table">
        <thead>
          <tr>
            <th>Показник</th>
            <th>Значення</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Температура</td>
            <td>{{selectedCity.temperature}} &deg;C</td>
          </tr>
          <tr>
            <td>Вологість</td>
            <td>{{selectedCity.humidity}} %</td>
          </tr>
          <tr>
            <td>Тиск</td>
            <td>{{selectedCity.pressure}} мм рт.ст.</td>
          </tr>
        </tbody>
      </table>
    </main>

  </div>

  {{> footer}}

</body>
</html>
