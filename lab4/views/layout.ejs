<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Inventory</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<% if (typeof locals.session !== 'undefined' && locals.session && locals.session.userId) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/dashboard">Inventory App</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
        <li class="nav-item"><a class="nav-link" href="/items">Items</a></li>
        <% if (locals.session.role === 'admin') { %>
          <li class="nav-item"><a class="nav-link" href="/items/add">Add Item</a></li>
        <% } %>
        <li class="nav-item"><a class="nav-link" href="/history">History</a></li>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item">
          <span class="nav-link text-light">
            <%= locals.session.username %> (<%= locals.session.role %>)
          </span>
        </li>
        <li class="nav-item">
          <form action="/auth/logout" method="POST" class="d-inline">
            <button class="btn btn-outline-light btn-sm ms-2" type="submit">Logout</button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>

<div class="container mt-4">
  <% if (typeof messages !== 'undefined') { %>
    <% if (messages.success && messages.success.length > 0) { %>
      <% messages.success.forEach(msg => { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    <% } %>
    <% if (messages.error && messages.error.length > 0) { %>
      <% messages.error.forEach(msg => { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= msg %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% }) %>
    <% } %>
  <% } %>

  <%- body %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
